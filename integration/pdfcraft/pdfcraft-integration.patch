diff --git a/crates/automation/src/scanning.rs b/crates/automation/src/scanning.rs
new file mode 100644
index 0000000000000000000000000000000000000000..1544186bce01e908e59092454e4fc352ff70d6f0
--- /dev/null
+++ b/crates/automation/src/scanning.rs
@@ -0,0 +1,92 @@
+//! Headless scanner access through the same module as the desktop. Every persistent path
+//! is resolved through the automation roots before the companion receives it.
+
+use crate::{Args, Automation, Result, ToolError, failed};
+use serde_json::{Value, json};
+
+impl Automation {
+    pub(crate) fn scanner_devices(&self) -> Result<Value> {
+        pdfcraft_engine::scanner::invoke("devices", None).map_err(failed)
+    }
+
+    pub(crate) fn scanner_capabilities(&self, a: &Args) -> Result<Value> {
+        pdfcraft_engine::scanner::invoke("capabilities", Some(&json!({"deviceId": a.str("device_id")?}))).map_err(failed)
+    }
+
+    pub(crate) fn scanner_scan(&self, a: &Args) -> Result<Value> {
+        let output = self.resolve(a.str("path")?, true)?;
+        let session = self.resolve(a.str("session_path")?, true)?;
+        let profile = a
+            .get("profile")
+            .filter(|v| v.is_object())
+            .ok_or_else(|| ToolError::InvalidArgs("profile must be an OpenScan v1 settings object".into()))?;
+        if output.exists() || session.exists() {
+            return Err(ToolError::InvalidArgs("Choose a new PDF path and a new session directory; existing data is never overwritten".into()));
+        }
+        pdfcraft_engine::scanner::invoke("scan", Some(&json!({"profile": profile, "output": output, "sessionDirectory": session}))).map_err(failed)
+    }
+
+    pub(crate) fn scanner_presets(&self, a: &Args) -> Result<Value> {
+        let directory = self.resolve(a.str("directory")?, false)?;
+        pdfcraft_engine::scanner::invoke("preset-list", Some(&json!({"directory": directory}))).map_err(failed)
+    }
+
+    pub(crate) fn scanner_preset_save(&self, a: &Args) -> Result<Value> {
+        let directory = self.resolve(a.str("directory")?, true)?;
+        let profile = a
+            .get("profile")
+            .filter(|v| v.is_object())
+            .ok_or_else(|| ToolError::InvalidArgs("profile must be an OpenScan v1 settings object".into()))?;
+        pdfcraft_engine::scanner::invoke(
+            "preset-save",
+            Some(&json!({"directory": directory, "profile": profile, "overwrite": a.opt_bool("overwrite")?.unwrap_or(false)})),
+        )
+        .map_err(failed)
+    }
+
+    pub(crate) fn scanner_preset_delete(&self, a: &Args) -> Result<Value> {
+        let directory = self.resolve(a.str("directory")?, true)?;
+        pdfcraft_engine::scanner::invoke("preset-delete", Some(&json!({"directory": directory, "name": a.str("name")?}))).map_err(failed)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn scanner_tools_refuse_paths_outside_the_root_before_starting_a_driver() {
+        let root = std::env::temp_dir().join(format!("scanner-root-{}", std::process::id()));
+        std::fs::create_dir_all(&root).unwrap();
+        let mut automation = Automation::new().with_root(&root).unwrap();
+        assert!(automation.call("scanner_scan", &json!({"path":"../escape.pdf","session_path":"session","profile":{}})).is_err());
+        assert!(automation.call("scanner_preset_save", &json!({"directory":"../escape","profile":{"name":"test"}})).is_err());
+        assert!(automation.call("scanner_preset_delete", &json!({"directory":"../escape","name":"test"})).is_err());
+        std::fs::remove_dir(&root).unwrap();
+    }
+
+    #[test]
+    #[ignore = "requires the built OpenScan companion selected by PDFCRAFT_SCANNER"]
+    fn scanner_presets_round_trip_through_the_companion() {
+        let suffix = pdfcraft_platform::staging::staging_suffixes().next().unwrap();
+        let root = std::env::temp_dir().join(format!("scanner-presets-{suffix}"));
+        std::fs::create_dir(&root).unwrap();
+        let mut automation = Automation::new().with_root(&root).unwrap();
+        let save = json!({"directory":"presets","profile":{"name":"Document","dpi":200,"cleanup":{"deskew":true}}});
+        assert!(automation.call("scanner_preset_save", &save).is_ok());
+        assert!(automation.call("scanner_preset_save", &save).is_err());
+        let listed = automation.call("scanner_presets", &json!({"directory":"presets"})).unwrap();
+        let crate::Content::Json(value) = &listed[0] else { panic!("expected JSON") };
+        assert_eq!(value["presets"][0]["name"], "Document");
+        assert_eq!(value["presets"][0]["dpi"], 200);
+        assert!(
+            automation.call("scanner_preset_save", &json!({"directory":"presets","profile":{"name":"Document","dpi":300},"overwrite":true})).is_ok()
+        );
+        assert!(automation.call("scanner_preset_delete", &json!({"directory":"presets","name":"Document"})).is_ok());
+        let listed = automation.call("scanner_presets", &json!({"directory":"presets"})).unwrap();
+        let crate::Content::Json(value) = &listed[0] else { panic!("expected JSON") };
+        assert_eq!(value["presets"].as_array().unwrap().len(), 0);
+        std::fs::remove_dir(root.join("presets")).unwrap();
+        std::fs::remove_dir(root).unwrap();
+    }
+}
