+//! The persistent toolbar reaches document history and keeps scanner commands by E-Sign.
+use egui_kittest::Harness;
+use egui_kittest::kittest::{NodeT, Queryable};
+use pdfcraft_engine::Edit;
+use pdfcraft_ui_egui::PdfCraftApp;
+
+fn harness(width: f32) -> Harness<'static, PdfCraftApp> {
+    let mut h = Harness::builder().with_size(egui::vec2(width, 900.0)).build_eframe(|_| {
+        let mut app = PdfCraftApp::new();
+        app.set_option("language", "en").unwrap();
+        app.open_bytes("toolbar.pdf", None, include_bytes!("data/form.pdf").to_vec()).unwrap();
+        app
+    });
+    h.run_steps(4);
+    h
+}
+
+#[test]
+fn toolbar_arrows_undo_and_redo_the_active_document() {
+    let mut h = harness(1400.0);
+    let id = h.state().views[0].id;
+    let rotation = h.state().session.get(id).unwrap().info.pages[0].rotation;
+    assert!(h.get_by_label("Undo last action").accesskit_node().is_disabled());
+    assert!(h.get_by_label("Redo last action").accesskit_node().is_disabled());
+    assert!(h.state_mut().apply_edit(Edit::RotatePages { pages: vec![0], degrees: 90 }));
+    h.run_steps(3);
+    assert!(!h.get_by_label("Undo last action").accesskit_node().is_disabled());
+    h.get_by_label("Undo last action").click();
+    h.run_steps(3);
+    assert_eq!(h.state().session.get(id).unwrap().info.pages[0].rotation, rotation);
+    assert!(h.get_by_label("Undo last action").accesskit_node().is_disabled());
+    assert!(!h.get_by_label("Redo last action").accesskit_node().is_disabled());
+    h.get_by_label("Redo last action").click();
+    h.run_steps(3);
+    assert_eq!(h.state().session.get(id).unwrap().info.pages[0].rotation, (rotation + 90) % 360);
+    assert!(h.get_by_label("Redo last action").accesskit_node().is_disabled());
+    h.get_by_label("Undo last action").click();
+    h.run_steps(3);
+    assert!(h.state_mut().apply_edit(Edit::RotatePages { pages: vec![0], degrees: 180 }));
+    h.run_steps(3);
+    assert!(h.get_by_label("Redo last action").accesskit_node().is_disabled(), "a new edit replaces the redo branch");
+    h.state_mut().open_bytes("second.pdf", None, include_bytes!("data/form.pdf").to_vec()).unwrap();
+    h.run_steps(3);
+    assert!(h.get_by_label("Undo last action").accesskit_node().is_disabled(), "history belongs to the active document");
+    h.state_mut().active = None;
+    h.run_steps(3);
+    assert!(h.get_by_label("Undo last action").accesskit_node().is_disabled());
+    assert!(h.get_by_label("Redo last action").accesskit_node().is_disabled());
+}
+
+#[test]
+fn scanner_menu_stays_next_to_esign_with_both_actions() {
+    for width in [820.0, 1000.0, 1100.0, 1400.0] {
+        let mut h = harness(width);
+        let sign = h.get_by_label("E-Sign").rect();
+        let scanner = h.get_by_label("From Scanner").rect();
+        assert!(scanner.left() >= sign.right());
+        assert!(scanner.left() - sign.right() < 20.0, "scanner sits directly after E-Sign");
+        let undo = h.get_by_label("Undo last action").rect();
+        let redo = h.get_by_label("Redo last action").rect();
+        assert!(undo.right() <= redo.left());
+        assert!(redo.right() <= width);
+        let search = h.get_by_label("Find tools and commands").rect();
+        assert!(search.left() >= scanner.right(), "search leaves the mode tabs and scanner menu clear");
+        assert!(search.right() <= undo.left());
+        h.get_by_label("From Scanner").click();
+        h.run_steps(3);
+        h.get_by_label("Scan");
+        h.get_by_label("Manage presets");
+    }
+}
