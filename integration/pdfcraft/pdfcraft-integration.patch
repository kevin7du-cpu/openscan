diff --git a/crates/ui-egui/src/scanner_ui.rs b/crates/ui-egui/src/scanner_ui.rs
new file mode 100644
index 0000000000000000000000000000000000000000..17483f5887c6ffdae654c9f15c6c5f40ace59f36
--- /dev/null
+++ b/crates/ui-egui/src/scanner_ui.rs
@@ -0,0 +1,60 @@
+//! The acquisition/preset windows belong to the reusable companion. PdfCraft imports the
+//! saved PDF through its normal open pipeline, leaving every open document unchanged.
+
+use crate::PdfCraftApp;
+
+impl PdfCraftApp {
+    pub(crate) fn scanner_available(&self) -> bool {
+        #[cfg(not(target_arch = "wasm32"))]
+        {
+            self.scanner_job.is_none()
+        }
+        #[cfg(target_arch = "wasm32")]
+        {
+            false
+        }
+    }
+
+    pub(crate) fn start_scanner(&mut self, presets: bool) {
+        #[cfg(not(target_arch = "wasm32"))]
+        {
+            if self.scanner_job.is_some() {
+                return;
+            }
+            let (send, receive) = std::sync::mpsc::channel();
+            let ctx = self.ctx.clone();
+            let spawned = std::thread::Builder::new().name("scanner-dialog".into()).spawn(move || {
+                let result = pdfcraft_engine::scanner::invoke(if presets { "presets-dialog" } else { "dialog" }, None)
+                    .map(|reply| reply.get("path").and_then(serde_json::Value::as_str).map(str::to_owned));
+                let _ = send.send(result);
+                if let Some(ctx) = ctx {
+                    ctx.request_repaint();
+                }
+            });
+            match spawned {
+                Ok(_) => self.scanner_job = Some(receive),
+                Err(error) => self.notify_fmt("Cannot start scanner: {e}", &[("e", &error.to_string())]),
+            }
+        }
+        #[cfg(target_arch = "wasm32")]
+        let _ = presets;
+    }
+
+    #[cfg(not(target_arch = "wasm32"))]
+    pub(crate) fn poll_scanner(&mut self) {
+        let Some(receiver) = &self.scanner_job else { return };
+        let result = match receiver.try_recv() {
+            Ok(value) => value,
+            Err(std::sync::mpsc::TryRecvError::Empty) => return,
+            Err(std::sync::mpsc::TryRecvError::Disconnected) => Err("The scanner window closed unexpectedly".into()),
+        };
+        self.scanner_job = None;
+        match result {
+            Ok(Some(path)) => {
+                self.open_path(&path);
+            }
+            Ok(None) => {}
+            Err(error) => self.notify_fmt("Scanner: {e}", &[("e", &error)]),
+        }
+    }
+}
