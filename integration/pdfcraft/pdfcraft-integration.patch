diff --git a/crates/engine/src/scanner.rs b/crates/engine/src/scanner.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c589b7d55f5a1a99d34617a09b3c6be5256716b5
--- /dev/null
+++ b/crates/engine/src/scanner.rs
@@ -0,0 +1,142 @@
+//! Version 1 OpenScan adapter. No scanner or server starts until an explicit command.
+//! The companion executable is independent of PdfCraft and may be reused by any host.
+
+use serde_json::Value;
+use std::io::{Read, Write};
+use std::path::PathBuf;
+use std::process::{Command, Stdio};
+use std::time::{Duration, Instant};
+
+const MAX_REPLY: usize = 4 * 1024 * 1024;
+
+/// Packaged as `scanner/openscan[.exe]` next to the application. Development hosts may
+/// explicitly select an absolute executable through PDFCRAFT_SCANNER; never search cwd/PATH.
+pub fn executable() -> Result<PathBuf, String> {
+    let path = match std::env::var_os("PDFCRAFT_SCANNER") {
+        Some(value) => PathBuf::from(value),
+        None => std::env::current_exe()
+            .map_err(|e| e.to_string())?
+            .parent()
+            .ok_or("Cannot locate the application folder")?
+            .join("scanner")
+            .join(if cfg!(target_os = "windows") { "openscan.exe" } else { "openscan" }),
+    };
+    if !path.is_absolute() || !path.is_file() {
+        return Err("Scanner module is not installed. Place the OpenScan package in the scanner folder beside PdfCraft, or set PDFCRAFT_SCANNER to its absolute executable path.".into());
+    }
+    Ok(path)
+}
+
+/// Calls the companion's JSON protocol. Physical scans time out after 15 minutes;
+/// interactive dialogs can remain open until the user finishes. Reply size is bounded.
+pub fn invoke(command: &str, request: Option<&Value>) -> Result<Value, String> {
+    invoke_at(&executable()?, command, request)
+}
+
+fn invoke_at(exe: &std::path::Path, verb: &str, request: Option<&Value>) -> Result<Value, String> {
+    if !matches!(
+        verb,
+        "dialog" | "presets-dialog" | "devices" | "capabilities" | "scan" | "preset-list" | "preset-save" | "preset-delete" | "version"
+    ) {
+        return Err("Unsupported scanner command".into());
+    }
+    let mut command = Command::new(exe);
+    command.arg(verb);
+    if verb == "dialog" {
+        command.arg("--return-json");
+    }
+    command.stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::null());
+    #[cfg(target_os = "windows")]
+    {
+        use std::os::windows::process::CommandExt;
+        command.creation_flags(0x0800_0000); // No console window; the companion opens its own dialog.
+    }
+    let mut child = command.spawn().map_err(|e| format!("Cannot start scanner module: {e}"))?;
+    if let Some(mut input) = child.stdin.take() {
+        let bytes = request.map(serde_json::to_vec).transpose().map_err(|e| e.to_string())?.unwrap_or_default();
+        if let Err(error) = input.write_all(&bytes) {
+            let _ = child.kill();
+            let _ = child.wait();
+            return Err(format!("Cannot send scanner settings: {error}"));
+        }
+    }
+    let stdout = child.stdout.take().ok_or("Scanner module did not provide a response pipe")?;
+    let (send, receive) = std::sync::mpsc::channel();
+    if let Err(error) = std::thread::Builder::new().name("scanner-response".into()).spawn(move || {
+        let mut bytes = Vec::new();
+        let result = stdout.take((MAX_REPLY + 1) as u64).read_to_end(&mut bytes).map(|_| bytes).map_err(|e| e.to_string());
+        let _ = send.send(result);
+    }) {
+        let _ = child.kill();
+        let _ = child.wait();
+        return Err(format!("Cannot read scanner response: {error}"));
+    }
+    let interactive = matches!(verb, "dialog" | "presets-dialog");
+    let started = Instant::now();
+    let mut reply = None;
+    let status = loop {
+        if reply.is_none() {
+            match receive.try_recv() {
+                Ok(Ok(bytes)) if bytes.len() <= MAX_REPLY => reply = Some(bytes),
+                Ok(_) | Err(std::sync::mpsc::TryRecvError::Disconnected) => {
+                    let _ = child.kill();
+                    let _ = child.wait();
+                    return Err("Scanner response exceeded its size limit or could not be read".into());
+                }
+                Err(std::sync::mpsc::TryRecvError::Empty) => {}
+            }
+        }
+        match child.try_wait() {
+            Ok(Some(status)) => break status,
+            Ok(None) => {}
+            Err(error) => {
+                let _ = child.kill();
+                let _ = child.wait();
+                return Err(error.to_string());
+            }
+        }
+        if !interactive && started.elapsed() > Duration::from_secs(900) {
+            let _ = child.kill();
+            let _ = child.wait();
+            return Err("Scanner operation timed out. Check the scanner; received pages may remain in the scan session folder.".into());
+        }
+        std::thread::sleep(Duration::from_millis(40));
+    };
+    let bytes = match reply {
+        Some(bytes) => bytes,
+        None => receive.recv_timeout(Duration::from_secs(2)).map_err(|e| e.to_string())??,
+    };
+    decode_reply(&bytes, status.success())
+}
+
+fn decode_reply(bytes: &[u8], success: bool) -> Result<Value, String> {
+    if bytes.len() > MAX_REPLY {
+        return Err("Scanner response exceeds 4 MB".into());
+    }
+    let value: Value = serde_json::from_slice(bytes).map_err(|e| format!("Invalid scanner response: {e}"))?;
+    if value.get("protocolVersion").and_then(Value::as_u64) != Some(1) {
+        return Err("Incompatible scanner protocol; expected version 1".into());
+    }
+    if !success || value.get("ok").and_then(Value::as_bool) != Some(true) {
+        return Err(value
+            .get("error")
+            .and_then(Value::as_str)
+            .or_else(|| value.pointer("/result/warning").and_then(Value::as_str))
+            .unwrap_or("Scanner operation did not complete. Check the scanner and session folder.")
+            .into());
+    }
+    Ok(value)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn scanner_protocol_checks_version_errors_and_cancellation() {
+        assert!(decode_reply(br#"{"ok":true,"protocolVersion":1,"cancelled":true,"path":null}"#, true).is_ok());
+        assert!(decode_reply(br#"{"ok":true,"protocolVersion":2}"#, true).is_err());
+        assert_eq!(decode_reply(br#"{"ok":false,"protocolVersion":1,"error":"paper jam"}"#, false).unwrap_err(), "paper jam");
+        assert!(decode_reply(b"not JSON", true).is_err());
+        assert!(decode_reply(&vec![b' '; MAX_REPLY + 1], true).is_err());
+    }
+}
