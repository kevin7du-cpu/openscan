+fn with_app_icon(mut viewport: egui::ViewportBuilder, macos: bool, executable: Option<&std::path::Path>) -> egui::ViewportBuilder {
+    if use_embedded_app_icon(macos, executable) {
+        match eframe::icon_data::from_png_bytes(APP_ICON_PNG) {
+            Ok(icon) => viewport = viewport.with_icon(icon),
+            Err(e) => log::warn!("app icon: {e}"),
+        }
+    } else {
+        // None makes eframe substitute its own logo. Its explicit empty-icon sentinel
+        // suppresses AppTitleIconSetter, leaving AppKit's bundle/Finder icon intact.
+        viewport = viewport.with_icon(egui::IconData::default());
+    }
+    viewport
+}
+
+fn use_embedded_app_icon(macos: bool, executable: Option<&std::path::Path>) -> bool {
+    if !macos {
+        return true;
+    }
+    let bundled = executable.and_then(std::path::Path::parent).is_some_and(|binaries| {
+        binaries.file_name() == Some(std::ffi::OsStr::new("MacOS"))
+            && binaries.parent().is_some_and(|contents| {
+                contents.file_name() == Some(std::ffi::OsStr::new("Contents"))
+                    && contents
+                        .parent()
+                        .and_then(std::path::Path::extension)
+                        .is_some_and(|extension| extension.as_encoded_bytes().eq_ignore_ascii_case(b"app"))
+            })
+    });
+    !bundled
+}
